# Local: copy to .streamlit/secrets.toml (git-ignored).
# Streamlit Cloud: paste these into Advanced settings -> Secrets.
NVIDIA_API_KEY = "nvapi-..."
DATABASE_URL = "postgresql://user:pass@host/dbname"   # Neon/Supabase Postgres; without it data is lost on every restart
EMBEDDING_PROVIDER = "nvidia"
# NVIDIA_MODEL = "meta/llama-3.1-70b-instruct"
# NVIDIA_EMBEDDING_MODEL = "nvidia/nv-embedqa-e5-v5"
