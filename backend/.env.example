# Copy this file to .env and fill in your key.
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=ragnarok_corpus
DATABASE_URL=sqlite:///./data/ragnarok.db

TOP_K=5
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
MIN_RELEVANCE_SCORE=0.15

MAX_CHUNK_SENTENCES=3

# --- Research assistant (no API key needed -- uses DuckDuckGo web search) ---
RESEARCH_MAX_QUERIES=4
RESEARCH_RESULTS_PER_QUERY=3
RESEARCH_MAX_SOURCES=6
RESEARCH_FETCH_TIMEOUT=15
RESEARCH_MAX_CHARS_PER_SOURCE=6000
RESEARCH_USE_ACADEMIC_ARCHIVES=true

# --- Academic archive search (all optional; arXiv/CrossRef work with no key at all) ---
CROSSREF_MAILTO=
PATENTSVIEW_API_KEY=

# --- Auth ---
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Deployment ---
# Hosted Postgres (e.g. Neon free tier) keeps users/cases/documents across container restarts.
# DATABASE_URL=postgresql://user:pass@host/dbname
# JSON list of allowed frontend origins:
# CORS_ORIGINS=["https://your-app.vercel.app"]
# Optional regex so Vercel preview deployments also work:
# CORS_ORIGIN_REGEX=https://your-app.*\.vercel\.app
