# ============================================================
# Evidentia-RAG backend — copy this to .env and fill in keys
# ============================================================

# --- LLM: choose ONE primary provider ---
# Option A: NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Option B / Gemini fallback (used automatically when NVIDIA fails)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Embeddings ---
# "local"  → sentence-transformers on CPU (no API key needed, works out of the box)
# "gemini" → Google text-embedding-004 (requires GEMINI_API_KEY above)
# "nvidia" → NVIDIA NIM (requires NVIDIA_API_KEY; falls back to local on error)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# --- Storage ---
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=ragnarok_corpus
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./data/ragnarok.db
# Postgres (optional, survives container restarts):
# DATABASE_URL=postgresql://user:pass@host/dbname

# --- Retrieval ---
TOP_K=5
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
MIN_RELEVANCE_SCORE=0.15

# --- Chunking ---
MAX_CHUNK_SENTENCES=5

# --- Research assistant ---
RESEARCH_MAX_QUERIES=4
RESEARCH_RESULTS_PER_QUERY=3
RESEARCH_MAX_SOURCES=6
RESEARCH_FETCH_TIMEOUT=8
RESEARCH_MAX_CHARS_PER_SOURCE=6000
# Set false to only use web search (arXiv/CrossRef return DOI URLs that can't always be fetched)
RESEARCH_USE_ACADEMIC_ARCHIVES=false

# --- Academic archive search (optional) ---
CROSSREF_MAILTO=
PATENTSVIEW_API_KEY=

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Deployment ---
# CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=https://your-app.*\.vercel\.app
